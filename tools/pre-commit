#!/bin/sh
# Reise nach Japan (PWA): Cache-Version in sw.js automatisch hochzaehlen.
# Nur wenn sich eine GECACHTE Datei aendert (nicht bei reinen Doku-/Tool-Commits), damit
# installierte Geraete nicht unnoetig > 100 MB neu laden.
# Ersetzung via PowerShell (WriteAllText), da sed -i im Google-Drive-Ordner scheitert.
# Installieren:  cp tools/pre-commit .git/hooks/pre-commit

sw="sw.js"
[ -f "$sw" ] || exit 0

staged=$(git diff --cached --name-only)
[ -z "$staged" ] && exit 0

relevant=$(printf '%s\n' "$staged" | grep -vE '^(README\.md|Konzept\.md|\.gitignore|\.nojekyll|sw\.js|tools/.*|models/.*)$')
[ -z "$relevant" ] && exit 0

cur=$(grep -oE "reise-nach-japan-v[0-9]+" "$sw" | head -1 | grep -oE "[0-9]+$")
[ -z "$cur" ] && exit 0
next=$((cur + 1))

swwin=$(cygpath -w "$(pwd)/$sw" 2>/dev/null || echo "$(pwd)/$sw")
powershell.exe -NoProfile -Command "\$p='$swwin'; \$e=New-Object System.Text.UTF8Encoding(\$false); \$t=[IO.File]::ReadAllText(\$p,\$e); \$t=\$t -replace 'reise-nach-japan-v[0-9]+','reise-nach-japan-v$next'; [IO.File]::WriteAllText(\$p,\$t,\$e)" || {
  echo "PWA-Hook: PowerShell-Ersetzung fehlgeschlagen, Commit abgebrochen." >&2
  exit 1
}

if ! grep -q "reise-nach-japan-v$next" "$sw"; then
  echo "PWA-Hook: Bump nicht verifizierbar, Commit abgebrochen." >&2
  exit 1
fi

git add "$sw"
echo "PWA-Cache: reise-nach-japan-v$cur -> reise-nach-japan-v$next"
exit 0